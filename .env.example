# Set these values in your process environment; do not commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret

# Local development uses SQLite. Set postgres only after the Supabase schema
# has been applied and DATABASE_URL contains the Session Pooler URL (port 5432).
DB_BACKEND=sqlite
DATABASE_URL=

# Local uploads remain the default. Supabase Storage requires three private
# buckets and a server-only service-role key; never expose this key in templates.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_REQUESTS=barangayconnect-requests
SUPABASE_STORAGE_BUCKET_COMPLAINTS=barangayconnect-complaints
SUPABASE_STORAGE_BUCKET_PROFILES=barangayconnect-profiles

# Supply these in the process environment for local setup; never commit real values.
FOUNDING_ADMIN_NAME=
FOUNDING_ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_RESIDENT_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Set this to the exact sender address verified by your email provider.
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Render: use Brevo HTTPS API instead of SMTP. SMTP connection settings above
# are not needed when EMAIL_PROVIDER=brevo.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# Optional Brevo Reply-To address; unset to omit reply-to.
BREVO_REPLY_TO=

PASSWORD_RESET_TTL_MINUTES=5
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=30
